<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:padding="20dp">

    <!-- Header -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginBottom="16dp">

        <ImageButton
            android:id="@+id/btnBack"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:background="@drawable/bg_circle_button"
            android:src="@drawable/ic_arrow_back"
            android:scaleType="centerInside"
            android:elevation="4dp"
            android:contentDescription="Go Back" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="Phonics Sound"
            android:textSize="24sp"
            android:textStyle="bold"
            android:textColor="#E65100"
            android:gravity="center" />

        <Space
            android:layout_width="48dp"
            android:layout_height="48dp" />
    </LinearLayout>

    <!-- Main Letter Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        app:cardCornerRadius="28dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        android:layout_marginBottom="16dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:orientation="vertical"
            android:gravity="center"
            android:padding="24dp">

            <!-- Uppercase & Lowercase -->
            <TextView
                android:id="@+id/tvDetailLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A a"
                android:textSize="64sp"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <!-- Phonics Sound -->
            <TextView
                android:id="@+id/tvDetailPhonics"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Sound: æ"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#00838F"
                android:layout_marginTop="8dp" />

            <!-- Emoji Illustration Card / Circle -->
            <FrameLayout
                android:layout_width="130dp"
                android:layout_height="130dp"
                android:layout_marginTop="16dp"
                android:background="@drawable/bg_circle_icon">

                <TextView
                    android:id="@+id/tvDetailEmoji"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="🍎"
                    android:textSize="65sp"
                    android:layout_gravity="center" />
            </FrameLayout>

            <!-- Example Word -->
            <TextView
                android:id="@+id/tvDetailWord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Apple"
                android:textSize="26sp"
                android:textStyle="bold"
                android:textColor="#E65100"
                android:layout_marginTop="12dp" />

        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Action Buttons -->
    <Button
        android:id="@+id/btnPlayLetterSound"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/play_letter_sound"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#FF7043"
        android:layout_marginBottom="8dp"
        app:cornerRadius="26dp" />

    <Button
        android:id="@+id/btnPlayExampleWord"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/play_example_word"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#42A5F5"
        android:layout_marginBottom="8dp"
        app:cornerRadius="26dp" />

    <Button
        android:id="@+id/btnRecordVoice"
        android:layout_width="match_parent"
        android:layout_height="52dp"
        android:text="@string/record_my_voice"
        android:textSize="15sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#26A69A"
        app:cornerRadius="26dp" />

</LinearLayout>

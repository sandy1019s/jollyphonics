<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="6dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:padding="12dp">

        <!-- Letter Icon Badge -->
        <FrameLayout
            android:layout_width="50dp"
            android:layout_height="50dp"
            android:background="@drawable/bg_circle_icon">

            <TextView
                android:id="@+id/tvItemBadgeLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textSize="22sp"
                android:textStyle="bold"
                android:textColor="#F57F17"
                android:layout_gravity="center" />
        </FrameLayout>

        <!-- Recording Info -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:layout_marginStart="12dp">

            <TextView
                android:id="@+id/tvItemTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Letter A - Apple"
                android:textSize="16sp"
                android:textStyle="bold"
                android:textColor="#37474F" />

            <TextView
                android:id="@+id/tvItemDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Nov 13, 2026"
                android:textSize="12sp"
                android:textColor="#78909C"
                android:layout_marginTop="2dp" />
        </LinearLayout>

        <!-- Play Button -->
        <ImageButton
            android:id="@+id/btnItemPlay"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_teal"
            android:src="@drawable/ic_play"
            android:scaleType="centerInside"
            android:elevation="3dp"
            android:contentDescription="Play recording"
            android:layout_marginEnd="8dp" />

        <!-- Delete Button -->
        <ImageButton
            android:id="@+id/btnItemDelete"
            android:layout_width="44dp"
            android:layout_height="44dp"
            android:background="@drawable/bg_circle_red"
            android:src="@drawable/ic_delete"
            android:scaleType="centerInside"
            android:elevation="3dp"
            android:contentDescription="Delete recording" />

    </LinearLayout>
</androidx.cardview.widget.CardView>

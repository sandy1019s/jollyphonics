<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/app_background"
    android:orientation="vertical"
    android:gravity="center_horizontal"
    android:padding="24dp">

    <!-- Top Space / Decorative header -->
    <Space
        android:layout_width="match_parent"
        android:layout_height="32dp" />

    <!-- App Title -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="JollyPhonics"
        android:textSize="38sp"
        android:textStyle="bold"
        android:textColor="#E65100"
        android:fontFamily="sans-serif-medium"
        android:shadowColor="#FFE082"
        android:shadowDx="2"
        android:shadowDy="2"
        android:shadowRadius="4" />

    <!-- Subtitle -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Learn Letters &amp; Sounds"
        android:textSize="18sp"
        android:textColor="#78909C"
        android:layout_marginTop="4dp"
        android:textStyle="bold" />

    <!-- Mascot Illustration Card -->
    <androidx.cardview.widget.CardView
        android:layout_width="220dp"
        android:layout_height="220dp"
        android:layout_marginTop="32dp"
        android:layout_marginBottom="32dp"
        app:cardCornerRadius="110dp"
        app:cardBackgroundColor="#FFF9C4"
        app:cardElevation="8dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="🦁"
                android:textSize="80sp" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hi Friend!"
                android:textSize="20sp"
                android:textStyle="bold"
                android:textColor="#F57F17"
                android:layout_marginTop="8dp" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

    <!-- Welcome Heading -->
    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_title"
        android:textSize="26sp"
        android:textStyle="bold"
        android:textColor="#37474F"
        android:gravity="center" />

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/welcome_subtitle"
        android:textSize="16sp"
        android:textColor="#607D8B"
        android:layout_marginTop="8dp"
        android:gravity="center" />

    <Space
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1" />

    <!-- Start Learning Button -->
    <Button
        android:id="@+id/btnStartLearning"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/start_learning"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#FF7043"
        android:elevation="6dp"
        android:layout_marginBottom="16dp"
        app:cornerRadius="30dp" />

    <!-- My Recordings Button -->
    <Button
        android:id="@+id/btnMyRecordings"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:text="@string/my_recordings"
        android:textSize="18sp"
        android:textStyle="bold"
        android:textColor="@color/white"
        android:backgroundTint="#26A69A"
        android:elevation="6dp"
        android:layout_marginBottom="24dp"
        app:cornerRadius="30dp" />

</LinearLayout>
